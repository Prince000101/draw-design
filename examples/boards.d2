vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
  }
}

direction: right

Phone: {
  shape: rectangle
  label: Phone
  sub: PWA + APK
  style: {
    fill: "#dbeafe"
    stroke: "#2563eb"
    border-radius: 8
  }
}

Relay: {
  shape: rectangle
  label: Relay
  sub: server + core
  style: {
    fill: "#d1fae5"
    stroke: "#059669"
    border-radius: 8
  }
}

Adapter: {
  shape: rectangle
  label: Adapter
  sub: opencode ×N
  style: {
    fill: "#d1fae5"
    stroke: "#059669"
    border-radius: 8
  }
}

Agent: {
  shape: rectangle
  label: Agent
  sub: opencode serve
  style: {
    fill: "#e2e8f0"
    stroke: "#475569"
    border-radius: 8
  }
}

Phone -> Relay: {
  label: 1 · POST /api/prompt
  style: {
    stroke: "#475569"
  }
}

layers: {
  step2: {
    Relay -> Adapter: {
      label: 2 · dequeue instruction
      style: {
        stroke: "#475569"
      }
    }
  }
  step3: {
    Adapter -> Agent: {
      label: 3 · prompt_async
      style: {
        stroke: "#475569"
      }
    }
  }
  step4: {
    Agent -> Adapter: {
      label: 4 · SSE events
      style: {
        stroke: "#2563eb"
      }
    }
  }
  step5: {
    Adapter -> Relay: {
      label: 5 · normalize feed item
      style: {
        stroke: "#2563eb"
      }
    }
  }
  step6: {
    Relay -> Phone: {
      label: 6 · SSE to chat
      style: {
        stroke: "#2563eb"
      }
    }
  }
  step7: {
    Agent -> Adapter: {
      label: 7 · permission.request
      style: {
        stroke: "#dc2626"
      }
    }
  }
  step8: {
    Adapter -> Relay: {
      label: 8 · approval.request
      style: {
        stroke: "#dc2626"
      }
    }
  }
  step9: {
    Relay -> Phone: {
      label: 9 · approval sheet
      style: {
        stroke: "#dc2626"
      }
    }
  }
  step10: {
    Phone -> Relay: {
      label: 10 · allow
      style: {
        stroke: "#059669"
      }
    }
  }
  step11: {
    Relay -> Adapter: {
      label: 11 · forward decision
      style: {
        stroke: "#059669"
      }
    }
  }
  step12: {
    Adapter -> Agent: {
      label: 12 · permissions allow
      style: {
        stroke: "#059669"
      }
    }
  }
}
